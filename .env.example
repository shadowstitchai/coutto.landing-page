# Copy to .env and fill in the AccessKey. Do not commit .env.
# cp .env.example .env

# Bucket coutto, cn-shanghai. Custom domain: coutto.cn
OSS_BUCKET=coutto

OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com

OSS_REGION=cn-shanghai

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Canonical URL baked into this production build (sitemap, absolute links).
# Leave _config.yml url as https://coutto.app for GitHub Pages.
SITE_URL=https://coutto.cn

OSS_WEBSITE_URL=https://coutto.cn
